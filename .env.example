# Copy to .env.local and fill in. Never commit .env.local.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-04

# Storefront tokens (see docs/shopify-setup.md, step 2). Only the private token is read by the code.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Admin API: Dev Dashboard app (proposed). Server-only.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin API fallback: legacy custom app token. Use instead of the two lines above.
# SHOPIFY_ADMIN_TOKEN=

# Signing secret for the product and collection webhooks that call /api/revalidate.
SHOPIFY_WEBHOOK_SECRET=

# Admin sign-in. Create ADMIN_PASSWORD_HASH with: npm run admin:hash-password
# SESSION_SECRET signs admin sessions: 32 or more random characters, never shared.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
