  "narrative": {
    "northStar": "The Beach Club Cabana",
    "overview": "The storefront reads like a striped beach cabana: a warm cream sand ground, chili maroon and sky blue stripes, and navy for text and lines. The jewellery is the bright accent, so the page keeps its colour in fields and bands rather than in decoration on top of the product.\n\nThe system is flat by default. Depth comes from tonal surfaces and a single soft maroon shadow on the primary action. Stripes frame a page edge or a hero field; they never sit behind body text. Motion is limited to one slow drift of the hero stripes, which reduced-motion settings stop.",
    "keyCharacteristics": [
      "Cream ground, not white or cool grey.",
      "Chili maroon for actions and headings; navy for text and every line.",
      "Stripes as fields and bands at page edges.",
      "Uppercase, heavy primary buttons; sentence-case secondary text.",
      "Pill-shaped header tools on a sand pill."
    ],
    "rules": [
      {
        "name": "The Stripe Edge Rule",
        "body": "Stripes frame a page edge or fill a hero field. They never sit behind text or form fields.",
        "section": "colors"
      },
      {
        "name": "The Navy Line Rule",
        "body": "Borders and text use navy. Maroon is for fills and primary actions, never for borders.",
        "section": "colors"
      },
      {
        "name": "The Heavy Headline Rule",
        "body": "Headlines carry the weight, not colour. Emphasis within a headline comes from size, not a second colour.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces are flat at rest. A shadow appears only as a response to a primary action or hover.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep primary actions in chili maroon with white uppercase text.",
      "Do set body text in navy or muted navy on cream and card white.",
      "Do use the stripe field only at a hero or section edge."
    ],
    "donts": [
      "Don't put stripes, dots, or checkers behind body text or form fields.",
      "Don't use the Citrus orange gradient hero or the checker band; both are retired.",
      "Don't use blur or glass as decoration.",
      "Don't introduce cool grey surfaces; the ground is cream."
    ]
  }
